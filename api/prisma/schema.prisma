// =============================================================================
// SISTEMA DE GERENCIAMENTO DE BIBLIOTECA DIGITAL (SGBD)
// PRISMA SCHEMA DEFINITION FOR POSTGRESQL
// Baseado nas especificações técnicas do projeto (ADRs, RFs, RNs)
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS DE NEGÓCIO
// -----------------------------------------------------------------------------

enum Role {
  LEITOR
  BIBLIOTECARIO
  ADMIN
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO_MULTA
  PENDENTE_LGPD
}

enum StatusExemplar {
  DISPONIVEL
  EMPRESTADO
  RESERVADO
  MANUTENCAO
}

enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO
  ATRASADO
}

enum StatusReserva {
  ATIVA
  ATENDIDA
  CANCELADA
}

enum StatusMulta {
  PENDENTE
  PAGA
  ISENTA
}

// -----------------------------------------------------------------------------
// MODELOS DE DADOS (TABELAS E RELACIONAMENTOS)
// -----------------------------------------------------------------------------

model Usuario {
  id                      String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome                    String        @db.VarChar(255)
  email                   String        @unique @db.VarChar(255)
  cpfHash                 String        @unique @map("cpf_hash") @db.VarChar(64)
  senhaHash               String        @map("senha_hash") @db.VarChar(255)
  papel                   Role          @default(LEITOR)
  status                  StatusUsuario @default(ATIVO)
  totalMultaPendente      Decimal       @default(0.00) @map("total_multa_pendente") @db.Decimal(10, 2)
  solicitouExclusaoLgpdEm DateTime?     @map("solicitou_exclusao_lgpd_em") @db.Timestamptz
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relacionamentos
  emprestimos             Emprestimo[]
  reservas                Reserva[]
  multas                  Multa[]
  notificacoes            Notificacao[]

  @@index([email])
  @@index([status])
  @@map("usuarios")
}

model Livro {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  titulo        String      @db.VarChar(255)
  autor         String      @db.VarChar(255)
  isbn          String      @unique @db.VarChar(20)
  categoria     String      @db.VarChar(100)
  editora       String      @db.VarChar(100)
  anoPublicacao Int         @map("ano_publicacao")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relacionamentos
  exemplares    Exemplar[]
  reservas      Reserva[]

  @@index([isbn])
  @@index([titulo])
  @@index([autor])
  @@map("livros")
}

model Exemplar {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigoPatrimonio String         @unique @map("codigo_patrimonio") @db.VarChar(100)
  livroId          String         @map("livro_id") @db.Uuid
  status           StatusExemplar @default(DISPONIVEL)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Relacionamentos
  livro            Livro          @relation(fields: [livroId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  emprestimos      Emprestimo[]

  @@index([codigoPatrimonio])
  @@index([livroId])
  @@index([status])
  @@map("exemplares")
}

model Emprestimo {
  id                    String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leitorId              String           @map("leitor_id") @db.Uuid
  exemplarId            String           @map("exemplar_id") @db.Uuid
  dataEmprestimo        DateTime         @default(now()) @map("data_emprestimo") @db.Timestamptz
  dataPrevistaDevolucao DateTime         @map("data_prevista_devolucao") @db.Timestamptz
  dataDevolucaoEfetiva  DateTime?        @map("data_devolucao_efetiva") @db.Timestamptz
  status                StatusEmprestimo @default(ATIVO)
  renovacoesQtd         Int              @default(0) @map("renovacoes_qtd")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relacionamentos
  leitor                Usuario          @relation(fields: [leitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exemplar              Exemplar         @relation(fields: [exemplarId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  multas                Multa[]

  @@index([leitorId])
  @@index([exemplarId])
  @@index([status])
  @@map("emprestimos")
}

model Reserva {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leitorId    String        @map("leitor_id") @db.Uuid
  livroId     String        @map("livro_id") @db.Uuid
  dataReserva DateTime      @default(now()) @map("data_reserva") @db.Timestamptz
  status      StatusReserva @default(ATIVA)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relacionamentos
  leitor      Usuario       @relation(fields: [leitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  livro       Livro         @relation(fields: [livroId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([livroId, status])
  @@map("reservas")
}

model Multa {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  emprestimoId String      @map("emprestimo_id") @db.Uuid
  leitorId     String      @map("leitor_id") @db.Uuid
  diasAtraso   Int         @default(0) @map("dias_atraso")
  valorTotal   Decimal     @map("valor_total") @db.Decimal(10, 2)
  status       StatusMulta @default(PENDENTE)
  dataQuitacao DateTime?   @map("data_quitacao") @db.Timestamptz
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relacionamentos
  emprestimo   Emprestimo  @relation(fields: [emprestimoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leitor       Usuario     @relation(fields: [leitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([leitorId, status])
  @@map("multas")
}

model Notificacao {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leitorId  String   @map("leitor_id") @db.Uuid
  tipo      String   @db.VarChar(50)
  mensagem  String   @db.Text
  enviadoEm DateTime @default(now()) @map("enviado_em") @db.Timestamptz

  // Relacionamentos
  leitor    Usuario  @relation(fields: [leitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([leitorId])
  @@map("notificacoes")
}